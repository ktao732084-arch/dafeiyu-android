# /etc/systemd/system/dafeiyu-feedback.service — see deploy/feedback/README.md.
[Unit]
Description=Dafeiyu in-app feedback relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/dafeiyu-feedback/feedback_relay.py
# Holds FEEDBACK_GITHUB_TOKEN and FEEDBACK_REPO; root-only (chmod 600), never in the repository.
EnvironmentFile=/etc/dafeiyu-feedback.env
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
